# =====================
# JWT 配置
# =====================
JWT_SECRET=your-super-secret-jwt-key-change-in-production-please-me
JWT_EXPIRATION=7200000

# =====================
# PostgreSQL 数据库
# =====================
POSTGRES_DB=ai_share
POSTGRES_USER=ai_share
POSTGRES_PASSWORD=ai_share_password

# =====================
# Redis 配置
# =====================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# =====================
# MinIO 对象存储
# =====================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=ai-share

# =====================
# 数据库配置 (后端使用)
# =====================
DB_HOST=postgres
DB_PORT=5432
DB_NAME=ai_share
DB_USER=ai_share
DB_PASSWORD=ai_share_password

# =====================
# Google OAuth2
# =====================
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost/login/oauth2/code/google

# =====================
# GitHub OAuth2
# =====================
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_REDIRECT_URI=http://localhost/login/oauth2/code/github